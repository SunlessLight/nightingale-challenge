# Nightingale — environment contract. KEY NAMES ONLY, never values.
# Copy to .env and fill in locally; add the same four to Vercel →
# Settings → Environment Variables (Production + Preview + Development).
# Vercel reads these at BUILD time — redeploy after adding or changing them.

# --- Public: inlined into the browser bundle. Never put a secret here. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server-only: must never reach the client. ---
# SUPABASE_SECRET_KEY bypasses Row Level Security. Server code only.
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=

# Optional. Required only if ANTHROPIC_API_KEY is an identity-linked key —
# without it the API returns 400 "anthropic-workspace-id is required".
# Anthropic Console → Settings → Workspaces (id looks like wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
